[Unit]
Description=GetNear agent (signs execute_chunk with the restricted key)
After=network-online.target getnear-oracle.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__/apps/agent
EnvironmentFile=/etc/getnear.env
Environment=PATH=__HOME__/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__PNPM__ start
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
