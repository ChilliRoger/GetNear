# /etc/getnear.env: configuration for the oracle and agent services. NO SECRETS belong here.
# The agent's restricted function-call key is a credential FILE under ~/.near-credentials, not an env var.

NEAR_NETWORK_ID=testnet
NEAR_RPC_URLS=https://rpc.testnet.near.org,https://test.rpc.fastnear.com

FX_BUDGET_CONTRACT_ID=fx-budget.chilliroger-operator.testnet
OPERATOR_ACCOUNT_ID=chilliroger-operator.testnet
AGENT_ACCOUNT_ID=chilliroger-agent.testnet
EURE_CONTRACT_ID=eure.chilliroger-operator.testnet
SPUTNIK_DAO_ACCOUNT_ID=chilliroger-dao.sputnik-v2.testnet

# Oracle (the only service exposed to the internet, read-only)
PORT=38174
AGENT_LOCAL_URL=http://127.0.0.1:38175

# Agent (stays on loopback; the oracle forwards its read-only routes under /agent/*)
AGENT_PORT=38175
AGENT_STRATEGY=score
AGENT_POLL_INTERVAL_MS=20000
NEAR_CLI_PATH=__HOME__/.cargo/bin/near
