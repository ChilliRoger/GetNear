{
  "name": "getnear",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test && pnpm test:scripts",
    "near:check": "tsx scripts/near/check-env.ts",
    "quotes:list": "tsx scripts/quotes/list-tokens.ts",
    "quotes:probe-minimums": "tsx scripts/quotes/probe-minimums.ts",
    "quotes:check": "tsx scripts/quotes/check-quotes.ts",
    "build:contract": "tsx scripts/build-contract.ts",
    "test:contract": "tsx contracts/fx-budget/tests/contract.test.ts",
    "dao:create": "tsx scripts/near/create-dao.ts",
    "contract:deploy": "tsx scripts/near/deploy-fx-budget.ts",
    "dao:bootstrap": "tsx scripts/near/bootstrap-dao.ts",
    "agent:add-key": "tsx scripts/near/add-agent-key.ts",
    "agent:start": "tsx apps/agent/src/index.ts",
    "agent:test": "pnpm --filter @getnear/agent test",
    "dao:vote": "tsx scripts/near/vote-proposal.ts",
    "demo:approval": "tsx scripts/near/demo-approval-flow.ts",
    "verify:readonly": "tsx scripts/verify-readonly.ts",
    "test:contract:rust": "cd contracts/fx-budget && cargo test --locked --lib",
    "test:scripts": "tsx scripts/near/order-args.test.ts",
    "upgrade:snapshot": "tsx scripts/upgrade-checks.ts snapshot",
    "upgrade:verify": "tsx scripts/upgrade-checks.ts verify",
    "evidence:balances": "tsx scripts/capture-invoice-evidence.ts balances",
    "evidence:capture": "tsx scripts/capture-invoice-evidence.ts capture",
    "contract:upgrade": "tsx scripts/near/deploy-fx-budget.ts"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "turbo": "^2.9.3",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.19.0 <25",
    "pnpm": ">=12"
  }
}
