# Copy this file to .env and fill in your values.

# Deployer wallet
DEPLOYER_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE
DEPLOYER_ADDRESS=0xB60679110E14D2291f8105EF002A49809cfB283b

# Alchemy RPC endpoints
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ARC_RPC=https://arc-testnet.g.alchemy.com/v2/YOUR_KEY
WORLDCHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/v2/YOUR_KEY

# Uniswap
UNISWAP_API_KEY=YOUR_UNISWAP_API_KEY

# Deployed contract addresses (2026-04-04)
MOCK_USDC_ARC=0x4Fa3A73189DaC96f6D44cf67f25301E010C78BB7
MOCK_EURC_ARC=0xe022c7abF67DD1C99D679f6C7f5912bb4404D956
TREASURY_VAULT_ARC=0x75a1ff87d9369fefeb2914bd6cc69296f7ebd997
SWAP_EXECUTOR_BASE=0xBcA2be0dCe857a936b4660538A9CCdDcB7aE92fF

# Demo mode (enables speed toggle + demo seed)
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Fynd (DEX aggregator)
TYCHO_API_KEY=replace-me
RPC_URL=https://base.llamarpc.com
FYND_CHAIN=base
FYND_HTTP_PORT=3000
FYND_METRICS_PORT=9898
RUST_LOG=fynd=info

# Unlink Privacy Sidecar
UNLINK_API_KEY=
UNLINK_MNEMONIC=
BASE_SEPOLIA_RPC=https://sepolia.base.org
PRIVACY_URL=http://localhost:38175
