# Frontend environment variables
# Copy to .env.local and fill in values

# RPC endpoints for on-chain reads (public, read-only — safe for client-side)
NEXT_PUBLIC_BASE_RPC=https://base.llamarpc.com
NEXT_PUBLIC_ARC_RPC=https://rpc-testnet.arc.money

# World ID (optional — falls back to demo mode if not set)
NEXT_PUBLIC_WORLD_ID_APP_ID=app_staging_demo
