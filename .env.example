# GetNear — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# NEAR Network (testnet only; mainnet is refused unless ALLOW_MAINNET=1 - roadmap, nothing deployed on mainnet)
NEAR_NETWORK_ID=testnet
NEAR_RPC_URLS=https://rpc.testnet.near.org,https://test.rpc.fastnear.com
NEAR_EXPLORER_BASE=https://testnet.nearblocks.io

# 1Click API (mainnet read-only, dry quotes only)
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# ONECLICK_JWT=  # Optional; dry quotes work without it

# Contract and account IDs (set after P7/P8 deployment)
FX_BUDGET_CONTRACT_ID=fx-budget.YOUR_PREFIX.testnet
DAO_ACCOUNT_ID=getnear-dao.sputnik-v2.testnet
AGENT_ACCOUNT_ID=agent.YOUR_PREFIX.testnet

# Agent signing key: the agent loads a near-cli credential FILE for its restricted FunctionCall key
# (execute_chunk on FX_BUDGET_CONTRACT_ID only). It does not read a private key from the environment.
# Auto-discovered from ~/.near-credentials/testnet/<AGENT_ACCOUNT_ID>/<public-key>.json, or set explicitly:
# AGENT_CREDENTIAL_PATH=
# SPUTNIK_DAO_ACCOUNT_ID=chilliroger-dao.sputnik-v2.testnet
# NEAR_CLI_PATH=            # near-cli-rs binary (only for write drills / the optional demo signer)
# NEAR_CLI_TIMEOUT_MS=120000

# --- Agent HTTP service (apps/agent) -------------------------------------------------------
# Binds to 127.0.0.1 by default. POST /trigger is DISABLED unless a token is set.
# AGENT_TRIGGER_TOKEN=            # >= 16 chars; required for POST /trigger
# AGENT_HOST=127.0.0.1            # a non-loopback host also needs AGENT_ALLOW_REMOTE=1
# AGENT_CORS_ORIGINS=             # comma-separated explicit origins; CORS is closed by default
# AGENT_ATTEMPT_LANDING_WINDOW_MS=108000000   # 30h: how long an unverifiable submission blocks a re-send
# AGENT_EXPIRE_SIGNER_ID=         # optional: account whose credential may call permissionless expire_order

# --- Optional server-side DEMO signer (team roles) ----------------------------------------
# OFF by default. Ordinary users sign with their own wallet. To enable the allow-listed operator/council
# signer and the demo faucet for a local team demo, set ALL of:
# GETNEAR_DEMO_SIGNER=1
# GETNEAR_DEMO_TOKEN=             # >= 16 chars; typed once per browser session (never bundled)
# NEXT_PUBLIC_DEMO_SIGNER=1       # shows the "Testnet Roles" tab in the UI
# AGENT_TRIGGER_URL=http://127.0.0.1:38175

# GetNear mode: mock | testnet
GETNEAR_MODE=mock

# Demo mode
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Optional: Natural-Language Order Intake (block P11 only — works without any key)
# Supports NEAR AI Cloud (https://cloud.near.ai) OR free tiers: Google AI Studio / Groq
# NEAR_AI_PROVIDER=nearai        # nearai | gemini | groq
# NEAR_AI_API_KEY=               # NEAR AI Cloud key (from https://cloud.near.ai or NEAR Builders)
# NEAR_AI_MODEL=z-ai/glm-5.3-flash
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# GEMINI_API_KEY=                # Optional free fallback (https://aistudio.google.com/apikey)
# GROQ_API_KEY=                  # Optional free fallback (https://console.groq.com/keys)

# ALLOW_MAINNET=1
# NEXT_PUBLIC_ALLOW_MAINNET=1
