# CRE workflow environment variables
# Copy to .env and fill in real values

# Ethereum private key for CRE simulation --broadcast
CRE_ETH_PRIVATE_KEY=0x_your_private_key_here

# Default CRE target
CRE_TARGET=staging-settings

# Uniswap Trade API key — must be set for quote fetching
# Note: CRE does NOT resolve ${VAR} in config.json, so the API key
# must be hardcoded in config.json for simulation. Before committing,
# replace with "${UNISWAP_API_KEY}" placeholder.
UNISWAP_API_KEY=your_uniswap_api_key_here
