# GetNear dashboard (apps/app): copy to .env.local. Testnet only; never put private keys here.

# Network (mainnet is refused unless ALLOW_MAINNET=1; nothing is deployed on mainnet)
NEXT_PUBLIC_NEAR_NETWORK_ID=testnet
NEAR_RPC_URLS=https://rpc.testnet.near.org,https://test.rpc.fastnear.com

# Deployed testnet contracts / accounts (defaults match the live demo deployment)
OPERATOR_ACCOUNT_ID=chilliroger-operator.testnet
NEXT_PUBLIC_FX_BUDGET_CONTRACT_ID=fx-budget.chilliroger-operator.testnet
FX_BUDGET_CONTRACT_ID=fx-budget.chilliroger-operator.testnet
SPUTNIK_DAO_ACCOUNT_ID=chilliroger-dao.sputnik-v2.testnet
EURE_CONTRACT_ID=eure.chilliroger-operator.testnet

# Backend services the dashboard reads (read-only). On a hosted deployment point these at your hosted services.
ORACLE_URL=http://localhost:38174
AGENT_API_URL=http://127.0.0.1:38175

# Optional natural-language order intake (works without any key: the form is always available)
# NEAR_AI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Server-side demo signer (local team demos ONLY, requires local near-cli credentials; keep OFF when deployed)
# GETNEAR_DEMO_SIGNER=1
# NEXT_PUBLIC_DEMO_SIGNER=1
# GETNEAR_DEMO_TOKEN=
# AGENT_TRIGGER_TOKEN=
