# ==============================================================================
# GetNear Testnet Stablecoin Faucet — Environment Configuration
# ==============================================================================

# Operator account that signs storage_deposit and mint transactions
OPERATOR_ACCOUNT_ID=chilliroger-operator.testnet

# ed25519 private key for operator account (Required for Vercel serverless deployment)
OPERATOR_PRIVATE_KEY=ed25519:YOUR_OPERATOR_PRIVATE_KEY_HERE

# Deployed NEP-141 token contracts on NEAR testnet
USDC_CONTRACT_ID=usdc.chilliroger-operator.testnet
EURE_CONTRACT_ID=eure.chilliroger-operator.testnet

# Network configuration
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
